export TERM="xterm-256color"
export CARGO_HOME="$HOME/.cargo"
export GOPATH="$HOME/.go"
export PYENV_ROOT="$HOME/.pyenv"
export RUSTUP_UPDATE_ROOT=https://mirrors.tuna.tsinghua.edu.cn/rustup/rustup
export RUSTUP_DIST_SERVER=https://mirrors.tuna.tsinghua.edu.cn/rustup

eval `dircolors "$HOME/.dircolors"`

# oh-my-zsh
ZSH="$HOME/.oh-my-zsh"
ZSH_CACHE_DIR="$HOME/.oh-my-zsh-cache"
ZSH_THEME="qupeng"
DISABLE_AUTO_UPDATE="true"
CASE_SENSITIVE="true"

[ ! -d $ZSH_CACHE_DIR ] && mkdir $ZSH_CACHE_DIR

plugins=(zsh-completions zsh-syntax-highlighting rust git)
source "$ZSH/oh-my-zsh.sh"

unsetopt AUTO_CD  # disable auto_cd when type dirname
autoload -U compinit
compinit

# key maps and alias
bindkey '^_[[Z' reverse-menu-complete
alias rm="rm -i"
alias ls="ls -h --color=auto"
alias ll="ls -l"
alias gg="exit"
alias tmux="tmux -u"


bins=("$HOME/.local/bin" "$HOME/.cargo/bin" "$HOME/.go/bin")
for bin in ${bins[@]}; do
    if [ -d $bin ] && [ ! `echo $PATH|grep $bin` ]; then
        export PATH=$bin:$PATH
    fi
done

# for golang.
if [ -d ".local/opt/go" ] && [ ! `echo $PATH|grep ".local/opt/go"` ]; then
    export PATH="$HOME/.local/opt/go/bin:$PATH"
fi

# for cmake.
if [ -d ".local/opt/cmake" ] && [ ! `echo $PATH|grep ".local/opt/cmake"` ]; then
    export PATH="$HOME/.local/opt/cmake-3.31.7/bin:$PATH"
fi

# for pyenv.
if [ -d "$HOME/.pyenv" ]; then
    [[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init - zsh)"
fi

fg() {
    if [ $# -eq 1 && $1 == - ]; then
        builtin fg %-
    else
        builtin fg %"$@"
    fi
}

bg() {
    if [ $# -eq 1 && $1 == - ]; then
        builtin bg %-
    else
        builtin bg %"$@"
    fi
}

# for dev tools.
if [ -d "/opt/tiger/typhoon-blade" ] && [ ! `echo $PATH|grep "typhoon-blade"` ]; then
    export PATH=/opt/tiger/typhoon-blade:$PATH
fi
