[user]
	name = qupeng.1
	email = qupeng.1@bytedance.com

[url "ssh://qupeng.1@git.byted.org:"]
	insteadOf = https://review.byted.org
[url "git@code.byted.org:"]
	insteadOf = https://code.byted.org/

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process
[push]
	default = simple
[core]
	editor = vim
	pager = less -FRSX
	excludesfile = ~/.gitignore
[diff]
	tool = vimdiff
[difftool]
	prompt = false
	trustExitCode = true
[alias]
	df = diff
	dt = difftool
[colors]
	ui = true
[http]
	cookiefile = /home/qupeng/.gitcookies
[diff "nodiff"]
	command = /bin/true
[color]
	ui = on
[include]
	path = "~/.gittoken"
[pull]
	rebase = false
