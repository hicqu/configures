[user]
	name = qupeng
	email = onlyqupeng@gmail.com
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process
[push]
	default = simple
[core]
	editor = vim
	pager = less -FRSX
	excludesfile = ~/.gitignore
[diff]
	tool = vimdiff
[difftool]
	prompt = false
	trustExitCode = true
[alias]
	df = diff
	dt = difftool
[colors]
	ui = true
[diff "nodiff"]
	command = /bin/true
[color]
	ui = on
[pull]
	rebase = false
